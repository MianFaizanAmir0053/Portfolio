# Copy to .env.local and fill in. Contact form is silently disabled without
# these — /api/contact returns a clear error instead of pretending to send.

# --- Email (Resend: https://resend.com) ---
# Free tier account. Without a verified sending domain you can still send
# to the email address your Resend account is signed up with — enough for a
# personal contact form.
RESEND_API_KEY=
# Where submissions land. Defaults to no destination — must be set.
CONTACT_TO_EMAIL=
# Optional. Defaults to Resend's shared test sender.
RESEND_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# --- Captcha (Cloudflare Turnstile: https://dash.cloudflare.com/?to=/:account/turnstile) ---
# Free. Add a widget for this site's domain to get both keys below.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
